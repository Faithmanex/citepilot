# CitePilot Web — Environment Configuration
# Everything (web + AI service) deploys to Vercel from this app.
# Copy to `.env.local` for local development, and set the same keys in the
# Vercel project (Settings → Environment Variables).

# ── AI service (ported from citepilot-ai; see src/lib/ai) ──────────────────
# Required for the /api/v1/analyse pipeline. Without it the endpoint returns 503.
GOOGLE_API_KEY=your_gemini_api_key_here
# Optional alias accepted if GOOGLE_API_KEY is not set:
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
LOG_LEVEL=info
CROSSREF_MAILTO=support@citepilot.ai
# OpenAlex dropped its `mailto` polite pool in February 2026 and now needs a
# free API key (https://openalex.org/settings/api). Without one, lookups share a
# tiny keyless budget per egress IP and are routinely rate-limited (HTTP 429),
# leaving references unverified. Get a key, then set it here and in Vercel.
OPENALEX_API_KEY=

# Optional shared-secret auth: when set, clients must send
# `X-API-Key: <key>` or `Authorization: Bearer <key>`.
API_KEY=
# Limits
MAX_UPLOAD_MB=10
MAX_TEXT_CHARS=200000
RATE_LIMIT_PER_MINUTE=60
# Latency budgets (ms). ANALYSIS_BUDGET_MS must stay below the route's
# maxDuration (60s) so the pipeline degrades gracefully instead of being
# killed with FUNCTION_INVOCATION_TIMEOUT.
ANALYSIS_BUDGET_MS=52000
# Per-provider-call ceiling; also the minimum time checked before another
# attempt is started.
GEMINI_TIMEOUT_MS=28000
# Gemini calls in flight at once. Keep at least the number of stages that start
# together (3): a lower gate makes the extra call wait for a slot and lose its
# window to the queue instead of to the provider.
LLM_CONCURRENCY=3
MIN_ATTEMPT_MS=2000
VERIFY_CONCURRENCY=6
VERIFY_TIMEOUT_MS=8000
# Provider readiness probes are cached for this long.
READINESS_CACHE_MS=300000

# ── Client ────────────────────────────────────────────────────────────────
# When unset, the client calls the co-located API at `<origin>/api/v1`.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase (auth, history, usage) ───────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── PayPal subscription ───────────────────────────────────────────────────
# Billing fails closed: with any of these missing, checkout reports "not configured"
# and /api/subscription/activate refuses to grant a paid tier. Unsigned PayPal
# webhook events are rejected when PAYPAL_WEBHOOK_ID is missing.
NEXT_PUBLIC_PAYPAL_PLAN_ID=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.paypal.com
PAYPAL_WEBHOOK_ID=
