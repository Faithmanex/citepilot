# CitePilot Web — Environment Configuration
# Everything (web + AI service) deploys to Vercel from this app.
# Copy to `.env.local` for local development, and set the same keys in the
# Vercel project (Settings → Environment Variables).

# ── AI service (ported from citepilot-ai; see src/lib/ai) ──────────────────
# Required for the /api/v1/analyse pipeline. Without it the endpoint returns 503.
GOOGLE_API_KEY=your_gemini_api_key_here
# Optional alias accepted if GOOGLE_API_KEY is not set:
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
LOG_LEVEL=info
CROSSREF_MAILTO=support@citepilot.ai

# Optional shared-secret auth: when set, clients must send
# `X-API-Key: <key>` or `Authorization: Bearer <key>`.
API_KEY=
# Limits
MAX_UPLOAD_MB=10
MAX_TEXT_CHARS=200000
RATE_LIMIT_PER_MINUTE=60

# ── Client ────────────────────────────────────────────────────────────────
# When unset, the client calls the co-located API at `<origin>/api/v1`.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase (auth, history, usage) ───────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── PayPal subscription ───────────────────────────────────────────────────
NEXT_PUBLIC_PAYPAL_PLAN_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.paypal.com
PAYPAL_WEBHOOK_ID=
